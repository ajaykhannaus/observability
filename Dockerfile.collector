# OpenTelemetry Collector image — Bucket 1.
# Upstream contrib image is distroless (no shell, no root in passwd).
# Use Alpine for entrypoint env substitution, copy the static otelcol binary.
# Use MCR Docker Hub mirror — avoids unauthenticated Docker Hub rate limits in ACR builds.
FROM mcr.microsoft.com/mirror/docker/otel/opentelemetry-collector-contrib:0.111.0 AS otel

FROM mcr.microsoft.com/mirror/docker/library/alpine:3.20

RUN apk add --no-cache ca-certificates

COPY --from=otel /otelcol-contrib /otelcol-contrib
COPY infra/otel-collector-azure-config.yaml /etc/otelcol-contrib/config.yaml
COPY azure/otel-collector-entrypoint.sh /otel-collector-entrypoint.sh
RUN chmod 755 /otel-collector-entrypoint.sh

USER 65534:65534

EXPOSE 4317 4318 8888 13133

ENTRYPOINT ["/otel-collector-entrypoint.sh"]
